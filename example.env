POSTGRES_PASSWORD=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Transaction pooler (port 6543) for app connections
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Session pooler (port 5432) for psql/migrations.
# Get this from Supabase Dashboard → Connect → Session pooler.
# Do NOT use db.YOUR_PROJECT_REF.supabase.co — that hostname often does not resolve.
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
UPDATE_PASSWORD=

# Public URL for link previews (Slack, iMessage, etc.). Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=https://your-app.onrender.com
